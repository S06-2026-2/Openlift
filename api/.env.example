# Sprint 1
DATABASE_URL=postgresql+psycopg://openlift:openlift@localhost:5432/openlift
ENV=development

# Sprint 2
JWT_SECRET=change-me
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
# Origens liberadas no CORS (regex). Padrão: qualquer porta em localhost/127.0.0.1
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Relays NOSTR (ADR-0007), separados por vírgula
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
NOSTR_RELAY_TIMEOUT_SECONDS=10
NOSTR_RELAY_MAX_RETRIES=3
# Worker de sincronização (python -m app.worker, ADR-0011)
NOSTR_SYNC_INTERVAL_SECONDS=300
# Logs JSON (OPS-08)
LOG_LEVEL=INFO
