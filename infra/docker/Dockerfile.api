# Imagem da API FastAPI.
# Build context é a raiz do repo (ver docker-compose.yml), por isso os
# caminhos abaixo começam com "api/".

FROM python:3.12-slim

WORKDIR /app

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ .

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# TODO(Sprint 6): build multi-stage para reduzir o tamanho da imagem final
